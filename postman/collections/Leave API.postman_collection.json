{
  "info": {
    "name": "Employee Leave Management - Leave API",
    "description": "Local Postman flow for leave types, balances, employee requests, manager decisions, and cancellation. Login requests capture generated tokens into the selected environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Login as employee (Zay)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"zay.demo@example.com\",\n  \"password\": \"DemoPassword123!\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Employee login succeeded', function () { pm.response.to.have.status(200); });", "if (pm.response.code === 200) pm.environment.set('employeeToken', pm.response.json().accessToken);"] } }]
    },
    {
      "name": "2. Login as manager (Aung)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"aung.demo@example.com\",\n  \"password\": \"DemoPassword123!\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Manager login succeeded', function () { pm.response.to.have.status(200); });", "if (pm.response.code === 200) pm.environment.set('managerToken', pm.response.json().accessToken);"] } }]
    },
    {
      "name": "3. GET leave types",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{employeeToken}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/api/leave-types"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Leave types returned', function () { pm.response.to.have.status(200); });", "if (pm.response.code === 200) {", "  const annual = pm.response.json().find(x => x.name === 'Postman Demo - Annual Leave');", "  if (annual) pm.environment.set('annualTypeId', annual.id);", "}"] } }]
    },
    {
      "name": "4. GET employee leave balance",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{employeeToken}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/api/leave-balances?year={{leaveYear}}"
      }
    },
    {
      "name": "5. POST create request for approval",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{employeeToken}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"leaveTypeId\": {{annualTypeId}},\n  \"startDate\": \"2026-12-22\",\n  \"endDate\": \"2026-12-23\",\n  \"reason\": \"Postman API approval test\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/leave-requests"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Request created', function () { pm.response.to.have.status(201); });", "if (pm.response.code === 201) pm.environment.set('requestId', pm.response.json().id);"] } }]
    },
    {
      "name": "6. GET my leave requests",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{employeeToken}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/api/leave-requests"
      }
    },
    {
      "name": "7. GET manager assigned requests",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{managerToken}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/api/leave-requests/assigned"
      }
    },
    {
      "name": "8. POST manager decision (approve)",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{managerToken}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"decision\": \"APPROVED\",\n  \"comments\": \"Approved for Postman testing\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/leave-requests/{{requestId}}/decision"
      }
    },
    {
      "name": "9. POST create a second request for cancellation",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{employeeToken}}", "type": "string" }] },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"leaveTypeId\": {{annualTypeId}},\n  \"startDate\": \"2026-12-28\",\n  \"endDate\": \"2026-12-29\",\n  \"reason\": \"Postman API cancellation test\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/leave-requests"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Cancellation request created', function () { pm.response.to.have.status(201); });", "if (pm.response.code === 201) pm.environment.set('cancelRequestId', pm.response.json().id);"] } }]
    },
    {
      "name": "10. POST cancel my pending request",
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{employeeToken}}", "type": "string" }] },
        "method": "POST",
        "url": "{{baseUrl}}/api/leave-requests/{{cancelRequestId}}/cancel"
      }
    }
  ]
}
